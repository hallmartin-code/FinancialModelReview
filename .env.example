# Required. Create at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. When set, the web app is gated behind HTTP Basic auth: any username,
# this password. Leave empty for an open deployment.
APP_PASSWORD=

# Optional web tuning.
# How long uploaded files and generated PDFs survive on the server.
# JOB_TTL_SECONDS=3600
# Concurrent analyses. Each one holds a deck in memory while Claude reads it.
# WEB_MAX_WORKERS=2
